generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             UserRole
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pettyCashRecords PettyCashRecord[]

  sentMessages  ManpowerChat[]
  notifications Notification[]
}

model Site {
  id                  String   @id @default(cuid())
  siteName            String   @unique

  startDate           DateTime?
  lastRenewalDate     DateTime?
  nextRenewalDate     DateTime?

  siteCategory        String?   // OWN | EXTERNAL | MISC
  siteRemark          String?

  manpowerSubmissions ManpowerSubmission[]
  manpowerTemplate    SiteManpower[]
  bdRenewals          BDRenewalLog[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SiteManpower {
  id          String   @id @default(cuid())
  siteId      String
  designation String
  authorised  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model ManpowerSubmission {
  id              String                   @id @default(cuid())
  siteId          String
  submittedByRole UserRole?
  submittedAt     DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  site            Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items           ManpowerSubmissionItem[]
  chats           ManpowerChat[]
}

model ManpowerSubmissionItem {
  id                 String             @id @default(cuid())
  submissionId       String
  designation        String
  authorised         Int
  deployed           Int?
  shortage           Int?
  needed             Int?               @default(0)
  responsible        String?
  cutoffDate         DateTime?
  remarks            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  recruitmentProcess String?
  submission         ManpowerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model PettyCashRecord {
  id                       String    @id @default(cuid())
  siteName                 String
  month                    String?
  paymentDate              DateTime?
  individualName           String?
  fixedAmount              Float?
  amountPaid               Float?
  additionalRequestRaised  String?
  lastDisbursement         String?
  pettyCashStatement       String?
  auditStatus              String?
  auditObservationStatus   String?
  purpose                  String?
  currentExpenditureStatus String?
  remarks                  String?
  createdById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdBy                User?     @relation(fields: [createdById], references: [id])
}

model FinanceRecord {
  id              String         @id @default(cuid())
  incharge        String?
  monthlyBilling  Float?
  invoiceDate     DateTime?
  invoiceAmount   Float?
  invoiceMonth    String?
  paymentStatus   PaymentStatus?
  salaryDate      DateTime?
  salaryAmount    Float?
  salaryMonth     String?
  updatedOn       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  createdBy       String?
  currentStage    String         @default("level1")
  lastRenewalDate DateTime?
  nextRenewalDate DateTime?
  siteName        String
  startDate       DateTime?
  status          String         @default("pending")
  updatedBy       String?
}

model ChecklistSubmission {
  id                 String             @id @default(cuid())
  supervisorName     String
  date               DateTime?
  timeText           String?
  siteVisitConducted String?
  siteVisitReason    String?
  siteName           String?
  telephonicCalling  String?
  telephonicSiteName String?
  telephonicIncharge String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  issueCount         Int                @default(0)
  okCount            Int                @default(0)
  status             String             @default("pending")
  answers            ChecklistAnswer[]
  comments           ChecklistComment[]
  issues             ChecklistIssue[]
}

model ChecklistAnswer {
  id           String              @id @default(cuid())
  submissionId String
  sectionName  String
  questionId   String?
  questionText String
  siteContext  String?
  answerValue  String?
  answerReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  source       ChecklistSource?
  submission   ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model ChecklistComment {
  id               String              @id @default(cuid())
  submissionId     String
  authorName       String
  message          String
  createdAt        DateTime            @default(now())
  readByAdmin      Boolean             @default(false)
  readBySupervisor Boolean             @default(false)
  authorRole       String
  submission       ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model ChecklistIssue {
  id           String              @id @default(cuid())
  submissionId String
  label        String
  status       String              @default("open")
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  submission   ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model FinanceSheetRecord {
  id                     String    @id @default(cuid())
  month                  String
  srNo                   Int
  siteName               String
  billAmount             Float?
  prepared               String
  prepareDate            String?
  dispatched             String
  dispatchDate           String?
  paymentCheque          String
  receivedDate           String?
  paymentReceivedDays    Int?

  // ✅ KEEP OLD
  salaryDisbursementDate String?

  // ✅ ADD NEW
  salaryStatus           String?

  source                 String?
  isActive               Boolean   @default(true)
  lastSyncedAt           DateTime?

  @@unique([month, srNo, siteName], name: "month_srNo_siteName")
  @@map("financeSheetRecord")
}

enum UserRole {
  admin
  supervisor
  level1
  level2
  level3
  account1
  account2
}

enum PaymentStatus {
  RECEIVED
  PENDING
}

enum RecruitmentProcess {
  Ongoing
  Completed
  NotStarted
}

enum ChecklistSource {
  BASIC
  COMMUNICATION
  SITE_VISIT
  TELEPHONIC
  STORE
}

model BDRenewalLog {
  id        String   @id @default(cuid())
  siteId    String
  status    String // Pending / In Progress / Confirmed
  remarks   String?
  updatedBy String?
  updatedAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id])
}

model BDReport {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  proposalsUnderProcess String?
  proposalsSent         String?
  tendersUnderProcess   String?
  tendersSubmitted      String?
  misc                  String?
 role                  String 
  createdAt DateTime @default(now())
}

model ManpowerChat {
  id           String @id @default(cuid())
  submissionId String

  message    String
  senderId   String
  senderRole UserRole

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  submission ManpowerSubmission @relation(fields: [submissionId], references: [id])
  sender     User               @relation(fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model OperationReport {
  id          String   @id @default(cuid())
  site        String
  note        String
  submissionId String?   // optional link to checklist
  createdAt   DateTime @default(now())
}