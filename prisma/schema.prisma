generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  supervisor
  level1
  level2
  level3
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
}

enum RecruitmentProcess {
  Ongoing
  Completed
  NotStarted
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Site {
  id                  String               @id @default(cuid())
  siteName            String               @unique
  incharge            String?
  startDate           DateTime?
  lastRenewalDate     DateTime?
  nextRenewalDate     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  manpowerTemplate    SiteManpower[]
  manpowerSubmissions ManpowerSubmission[]
  financeRecords      FinanceRecord[]
}

model SiteManpower {
  id           String   @id @default(cuid())
  siteId       String
  designation  String
  authorised   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model ManpowerSubmission {
  id              String                  @id @default(cuid())
  siteId          String
  submittedByRole UserRole?
  submittedAt     DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  site            Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items           ManpowerSubmissionItem[]
}

model ManpowerSubmissionItem {
  id                  String              @id @default(cuid())
  submissionId        String
  designation         String
  authorised          Int
  deployed            Int?
  shortage            Int?
  needed              Int?                @default(0)
  recruitmentProcess  String?
  responsible         String?
  cutoffDate          DateTime?
  remarks             String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  submission          ManpowerSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model FinanceRecord {
  id              String         @id @default(cuid())
  siteId          String
  incharge        String?
  monthlyBilling  Float?
  invoiceDate     DateTime?
  invoiceAmount   Float?
  invoiceMonth    String?
  paymentStatus   PaymentStatus?
  salaryDate      DateTime?
  salaryAmount    Float?
  salaryMonth     String?
  updatedOn       DateTime       @default(now())
  createdAt       DateTime       @default(now())

  site            Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum ChecklistSource {
  BASIC
  COMMUNICATION
  SITE_VISIT
  TELEPHONIC
  STORE
}

model ChecklistSubmission {
  id                    String             @id @default(cuid())
  supervisorName        String
  date                  DateTime?
  timeText              String?

  siteVisitConducted    String?
  siteVisitReason       String?
  siteName              String?

  telephonicCalling     String?
  telephonicSiteName    String?
  telephonicIncharge    String?

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  answers               ChecklistAnswer[]
  comments              ChecklistComment[]
}

model ChecklistAnswer {
  id              String               @id @default(cuid())
  submissionId    String
  sectionName     String
  source          ChecklistSource?
  questionId      String?
  questionText    String
  answerValue     String?
  answerReason    String?
  siteContext     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  submission      ChecklistSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model ChecklistComment {
  id                String               @id @default(cuid())
  submissionId      String
  authorName        String
  authorRole        String
  message           String
  readByAdmin       Boolean              @default(false)
  readBySupervisor  Boolean              @default(false)
  createdAt         DateTime             @default(now())

  submission        ChecklistSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}