generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             UserRole
    portal           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pettyCashRecords PettyCashRecord[]

fmSentMessages FmManpowerChat[] @relation("FmUserChats")
wmSentMessages WmManpowerChat[] @relation("WmUserChats")

fmNotifications FmNotification[] @relation("FmUserNotifications")
wmNotifications WmNotification[] @relation("WmUserNotifications")

fmRaisedIssues FmRaisedIssue[]
fmIssueHistories FmRaisedIssueHistory[]

dailySiteReports  DailySiteReport[]
travelVisitPlans  TravelVisitPlan[]
costLeakReports   CostLeakReport[]
costSavingReports CostSavingReport[]

amitojCommandTargets AmitojCommandTarget[]
amitojSiteControls   AmitojSiteControl[]
amitojTravelPlans    AmitojTravelVisitPlan[]
}

model FmSite {
  id                  String   @id @default(cuid())
  siteName            String   @unique

  startDate           DateTime?
  lastRenewalDate     DateTime?
  nextRenewalDate     DateTime?

  siteCategory        String?   // OWN | EXTERNAL | MISC
  siteRemark          String?

  manpowerSubmissions FmManpowerSubmission[]
  manpowerTemplate    FmSiteManpower[]
bdRenewals FmBDRenewalLog[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
   @@map("Site")
}
model WmSite {
  id                  String   @id @default(cuid())
  siteName            String   @unique

  startDate           DateTime?
  lastRenewalDate     DateTime?
  nextRenewalDate     DateTime?

  siteCategory        String?
  siteRemark          String?

  manpowerSubmissions WmManpowerSubmission[]
  manpowerTemplate    WmSiteManpower[]
bdRenewals WmBDRenewalLog[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model FmSiteManpower {
  id          String   @id @default(cuid())
  siteId      String
  designation String
  authorised  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        FmSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
    @@map("SiteManpower")
}
model WmSiteManpower {
  id          String   @id @default(cuid())
  siteId      String
  designation String
  authorised  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site WmSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
}

model FmManpowerSubmission {
  id              String                   @id @default(cuid())
  siteId          String
  submittedByRole UserRole?
  submittedAt     DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  site            FmSite                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items           FmManpowerSubmissionItem[]
  chats           FmManpowerChat[]
    @@map("ManpowerSubmission")
}
model WmManpowerSubmission {
  id              String   @id @default(cuid())
  siteId          String
  submittedByRole UserRole?

  submittedAt     DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site  WmSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items WmManpowerSubmissionItem[]
   chats           WmManpowerChat[]
}

model FmManpowerSubmissionItem {
  id                 String             @id @default(cuid())
  submissionId       String
  designation        String
  authorised         Int
  deployed           Int?
  shortage           Int?
  needed             Int?               @default(0)
  responsible        String?
  cutoffDate         DateTime?
  remarks            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  recruitmentProcess String?
  submission         FmManpowerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
    @@map("ManpowerSubmissionItem")
}
model WmManpowerSubmissionItem {
  id                 String   @id @default(cuid())
  submissionId       String

  designation        String
  authorised         Int
  deployed           Int?
  shortage           Int?
  needed             Int? @default(0)
priority String?
  responsible        String?
  cutoffDate         DateTime?
  remarks            String?

  recruitmentProcess String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  submission WmManpowerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model PettyCashRecord {
  id                       String    @id @default(cuid())
  siteName                 String
  month                    String?
  paymentDate              DateTime?
  individualName           String?
  fixedAmount              Float?
  amountPaid               Float?
  additionalRequestRaised  String?
  lastDisbursement         String?
  pettyCashStatement       String?
  auditStatus              String?
  auditObservationStatus   String?
  purpose                  String?
  currentExpenditureStatus String?
  remarks                  String?
  createdById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdBy                User?     @relation(fields: [createdById], references: [id])
}

model FinanceRecord {
  id              String         @id @default(cuid())
  incharge        String?
  monthlyBilling  Float?
  invoiceDate     DateTime?
  invoiceAmount   Float?
  invoiceMonth    String?
  paymentStatus   PaymentStatus?
  salaryDate      DateTime?
  salaryAmount    Float?
  salaryMonth     String?
  updatedOn       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  createdBy       String?
  currentStage    String         @default("level1")
  lastRenewalDate DateTime?
  nextRenewalDate DateTime?
  siteName        String
  startDate       DateTime?
  status          String         @default("pending")
  updatedBy       String?
}

model ChecklistSubmission {
  id                 String             @id @default(cuid())
  supervisorName     String
  date               DateTime?
  timeText           String?
  siteVisitConducted String?
  siteVisitReason    String?
  siteName           String?
  telephonicCalling  String?
  telephonicSiteName String?
  telephonicIncharge String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  issueCount         Int                @default(0)
  okCount            Int                @default(0)
  status             String             @default("pending")
  answers            ChecklistAnswer[]
  comments           ChecklistComment[]
  issues             ChecklistIssue[]
}

model ChecklistAnswer {
  id           String              @id @default(cuid())
  submissionId String
  sectionName  String
  questionId   String?
  questionText String
  siteContext  String?
  answerValue  String?
  answerReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  source       ChecklistSource?
  submission   ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model ChecklistComment {
  id               String              @id @default(cuid())
  submissionId     String
  authorName       String
  message          String
  createdAt        DateTime            @default(now())
  readByAdmin      Boolean             @default(false)
  readBySupervisor Boolean             @default(false)
  authorRole       String
  submission       ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model ChecklistIssue {
  id           String              @id @default(cuid())
  submissionId String
  label        String
  status       String              @default("open")
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  submission   ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model FinanceSheetRecord {
  id                     String    @id @default(cuid())

  portal                 String    @default("FM") // FM or WM

  month                  String
  srNo                   Int
  siteName               String
  billAmount             Float?
  prepared               String
  prepareDate            String?
  dispatched             String
  dispatchDate           String?
  paymentCheque          String
  receivedDate           String?
  paymentReceivedDays    Int?

  salaryDisbursementDate String?
  salaryStatus           String?

  source                 String?
  isActive               Boolean   @default(true)
  lastSyncedAt           DateTime?

  @@unique([portal, month, srNo, siteName], name: "portal_month_srNo_siteName")
  @@map("financeSheetRecord")
}

enum UserRole {
fmadmin
  supervisor
  fmlevel1
  fmlevel2
  fmlevel3
  site_supervisor
  wmadmin
   wmlevel1
  wmlevel2
  wmlevel3
  admin
level1
level2
level3
Ravi
Suyesh
Mahendra
Lakhan
Deepak
Amitoj
account1
account2
}

enum PaymentStatus {
  RECEIVED
  PENDING
}

enum RecruitmentProcess {
  Ongoing
  Completed
  NotStarted
}

enum ChecklistSource {
  BASIC
  COMMUNICATION
  SITE_VISIT
  TELEPHONIC
  STORE
}

model FmBDRenewalLog {
  id        String   @id @default(cuid())
  siteId    String

  status    String
  remarks   String?
  updatedBy String?

  updatedAt DateTime @default(now())

  site FmSite @relation(fields: [siteId], references: [id])

  @@map("BDRenewalLog")
}

model FmBDReport {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  proposalsUnderProcess String?
  proposalsSent         String?
  tendersUnderProcess   String?
  tendersSubmitted      String?
  misc                  String?

  role String

  createdAt DateTime @default(now())

  @@map("BDReport")
}

model WmBDRenewalLog {
  id        String   @id @default(cuid())
  siteId    String

  status    String
  remarks   String?
  updatedBy String?

  updatedAt DateTime @default(now())

  site WmSite @relation(fields: [siteId], references: [id])
}

model WmBDReport {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  proposalsUnderProcess String?
  proposalsSent         String?
  tendersUnderProcess   String?
  tendersSubmitted      String?
  misc                  String?

  role String

  createdAt DateTime @default(now())
}

model FmManpowerChat {
  id           String @id @default(cuid())
  submissionId String

  message    String
  senderId   String
  senderRole UserRole

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  submission FmManpowerSubmission @relation(fields: [submissionId], references: [id])
sender User @relation("FmUserChats", fields: [senderId], references: [id])
    @@map("ManpowerChat")
}

model WmManpowerChat {
  id           String @id @default(cuid())
  submissionId String

  message    String
  senderId   String
  senderRole UserRole

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  submission WmManpowerSubmission @relation(fields: [submissionId], references: [id])
sender User @relation("WmUserChats", fields: [senderId], references: [id])
}

model FmNotification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

user User @relation("FmUserNotifications", fields: [userId], references: [id])
    @@map("Notification")
}

model WmNotification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

user User @relation("WmUserNotifications", fields: [userId], references: [id])
}

model OperationReport {
  id          String   @id @default(cuid())
  site        String
  note        String
  submissionId String?   // optional link to checklist
  createdAt   DateTime @default(now())
}
model FmRaisedIssue {
  id String @id @default(cuid())

  issueNumber String @unique

  // ✅ REMOVE RELATION
  siteName String

  issueTitle String?

  observedIssue String

  presentState String?

  priority String? @default("MEDIUM")

  conveyedToSupervisor Boolean @default(false)
  supervisorAction String?
  supervisorCutoffDate DateTime?

  conveyedToHeadOffice Boolean @default(false)
  headOfficeAction String?
  headOfficeCutoffDate DateTime?

  issueResolved Boolean @default(false)

  resolutionRemark String?
  resolutionDate DateTime?

  currentStatus FmIssueStatus @default(PENDING)

  isDeleted Boolean @default(false)

  createdById String
  createdBy User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images FmRaisedIssueImage[]
  histories FmRaisedIssueHistory[]

  @@map("FmRaisedIssue")

  @@index([currentStatus])
  @@index([createdAt])
  @@index([createdById])
}
model FmRaisedIssueImage {
  id String @id @default(cuid())

  issueId String
  issue FmRaisedIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  imageUrl String

  createdAt DateTime @default(now())

  @@map("FmRaisedIssueImage")
}
model FmRaisedIssueHistory {
  id String @id @default(cuid())

  issueId String
  issue FmRaisedIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  actionType String
  actionRemark String?

  actionById String
  actionBy User @relation(fields: [actionById], references: [id])

  createdAt DateTime @default(now())

  @@map("FmRaisedIssueHistory")
}
enum FmIssueStatus {
  PENDING
  SUPERVISOR_NOTIFIED
  HEAD_OFFICE_NOTIFIED
  RESOLVED
  ESCALATED
}

model DailySiteReport {
  id                      String   @id @default(cuid())

  date                    DateTime
  siteName                String
  projectHead             String?

  manpowerAuthorized      String?
  deployed                String?
  needed                   String?

  billSubmittedDate       DateTime?
  billAmountAuthorised    Float?
  billAmountClaimed       Float?
  paymentStatus           String?
  paymentCreditDate       DateTime?

  salariesPaidForMonth    String?
  salaryRelatedIssue      String?

  operationalRisks        String?
  risksIfAny              String?
  operationalStatus       String?

  hrIssue                 String?
  issueDetails            String?

  clientStatus            String?
  siteStatus              String?

  createdById             String
  createdBy               User     @relation(fields: [createdById], references: [id])

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model TravelVisitPlan {
  id                String   @id @default(cuid())

  personTravelling String
  siteToVisit      String
  purpose          String?
  problemToAddress String?
  expectedOutcome  String?
  travelDate       DateTime?
  estimatedCost    Float?

  approvedByAmitoj Boolean?
  issueResolved    Boolean?
  whatWasResolved  String?
  stillPending     String?
  followUpRequired Boolean?
  mom              String?
  finalOutcome     String?

  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CostLeakReport {
  id               String   @id @default(cuid())

  site             String
  leakageType      String?
  description      String?
  monthlyImpact    Float?
  rootCause        String?
  correctiveAction String?
  owner            String?
  deadline         DateTime?
  status           String?

  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CostSavingReport {
  id                    String   @id @default(cuid())

  site                  String
  reductionSavingType   String?
  description           String?
  monthlyImpact         Float?
  owner                 String?
  deadline              DateTime?
  status                String?

  createdById           String
  createdBy             User     @relation(fields: [createdById], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum YesNo {
  YES
  NO
}

enum TrafficStatus {
  GREEN
  YELLOW
  RED
}
model AmitojCommandTarget {
  id              String   @id @default(cuid())

  targetArea      String
  targetValue     String?
  actual          String?
  needed            String?
  status          String?

  mdContextReason String?
  nextAction      String?
  deadline        DateTime?
  supportNeeded   String?

  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AmitojSiteControl {
  id                     String   @id @default(cuid())

  site                   String
  coordinator            String?

  authorisedAmount       Float?
  underBillingAmount     Float?
  commitmentDate         DateTime?

  billingStatus          String?
  siteStatus             String?
  clientControl          String?
  politicalRisk          String?
  coordinatorPerformance String?

  riskMdContext          String?
  lastAction             String?
  nextAction             String?

  owner                  String?
  deadline               DateTime?

  createdById            String
  createdBy              User     @relation(fields: [createdById], references: [id])

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AmitojTravelVisitPlan {
  id                String   @id @default(cuid())

  personTravelling String
  siteToVisit      String

  purpose          String?
  problemToAddress String?
  expectedOutcome  String?

  travelDate       DateTime?
  estimatedCost    Float?

  visitOutcome     String?
  issueResolved    Boolean?
  whatWasResolved  String?
  stillPending     String?
  followUpRequired Boolean?
  mom              String?
  finalOutcome     String?

  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}